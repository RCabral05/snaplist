# Copy to .env.local. Only EXPO_PUBLIC_* values belong here - they are compiled
# into the app binary and are therefore public.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In. Both are needed or the Google button stays hidden. Create them
# in the Google Cloud console: an iOS client bound to the bundle identifier, and
# a Web client whose ID is the audience Supabase validates the id token against.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Backend base URL, once it exists. The service-role key, the Postgres
# connection string and the marketplace secrets live THERE, never here.
EXPO_PUBLIC_API_URL=
