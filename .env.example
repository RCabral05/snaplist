# Copy to .env.local. Only EXPO_PUBLIC_* values belong here - they are compiled
# into the app binary and are therefore public.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend base URL, once it exists. The service-role key, the Postgres
# connection string and the marketplace secrets live THERE, never here.
EXPO_PUBLIC_API_URL=
